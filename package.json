{
  "name": "smart-meter-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "dev": "node --env-file=.env index.js",
    "meter": "node --env-file-if-exists=.env meter.cjs",
    "meter:capture": "node --env-file-if-exists=.env meter.cjs --capture-once",
    "meter:once": "node --env-file-if-exists=.env meter.cjs --write-once",
    "simulate": "node hardware/simulate.js",
    "start": "node index.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "firebase-admin": "^14.1.0",
    "node-fetch": "^2.7.0",
    "serialport": "^13.0.0",
    "smartmeter-obis": "^4.0.0"
  }
}
