FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
SMART_METER_INGEST_TOKEN=replace-with-a-long-random-secret

# Stable identifier returned by the v1 API and stored on new readings.
METER_ID=dtz541-demo

# Physical meter reader settings.
METER_SERIAL_PORT=COM5
METER_SERIAL_BAUDRATE=9600
METER_POLL_INTERVAL_MS=10000
METER_READ_TIMEOUT_MS=15000

# Authenticated simulator settings.
METER_API_URL=http://localhost:3000/api/data
SIMULATOR_INTERVAL_MS=5000

# Local web/API server.
PORT=3000
